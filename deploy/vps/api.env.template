# /etc/fluentra/api.env on the VPS (root:fluentra, mode 0640).
# Copy every other variable from the Render service unchanged; these differ on the VPS.
# systemd reads this file: no quotes, no inline comments, no $ expansion.
APP_ENV=production
HTTP_PORT=8080
# cloudflared connects from localhost; X-Forwarded-For is trusted only from it.
HTTP_TRUSTED_PROXIES=127.0.0.1,::1
# Vercel sets this to the learner's address; Cloudflare strips it from other callers.
HTTP_CLIENT_IP_HEADER=X-Vercel-Forwarded-For
WORKER_URL=https://fluentra-worker.onrender.com
DB_MAX_CONNS=8
GOMEMLIMIT=400MiB
OTEL_EXPORTER_OTLP_ENDPOINT=
