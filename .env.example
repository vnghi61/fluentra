# Fluentra configuration reference.
# Every key the application reads appears here. A key that is not here does not exist —
# add it deliberately, and document it in docs/deployment/configuration.md at the same time.
# Required keys have no default: the process refuses to start without them.
#
# Naming: a variable maps to one config key by lowercasing it and replacing the FIRST
# underscore with a dot. S3_ACCESS_KEY -> s3.access_key, HTTP_READ_TIMEOUT -> http.read_timeout.
# The segment before that first underscore is the section; only sections a binary declares
# are read. See internal/shared/config/config.go.

# ------------------------------------------------------------------ app
APP_ENV=local                      # local | ci | staging | production
APP_NAME=fluentra
APP_VERSION=dev
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_REQUEST_TIMEOUT=30s
HTTP_SHUTDOWN_GRACE=30s
# CIDRs of proxies allowed to set X-Forwarded-For. Empty means the socket
# address is always the client — the safe default when nothing fronts the API.
# Per-IP lockout and rate limiting depend on this being accurate.
HTTP_TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------- database
DB_DSN=postgres://fluentra:fluentra@localhost:5432/fluentra?sslmode=disable   # REQUIRED
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_STATEMENT_TIMEOUT=10s

# ---------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379/0                                            # REQUIRED
REDIS_POOL_SIZE=20
REDIS_TLS=false

# -------------------------------------------------------------- storage
S3_ENDPOINT=http://localhost:9000                                             # REQUIRED
S3_ACCESS_KEY=minioadmin                                                      # REQUIRED - secret
S3_SECRET_KEY=minioadmin                                                      # REQUIRED - secret
S3_REGION=us-east-1                       # AWS S3: your region. Cloudflare R2: use "auto"
S3_USE_SSL=false
# false for stores without S3 POST policy support (Cloudflare R2); true otherwise
S3_USE_POST_POLICY=true
S3_BUCKET_AVATARS=fluentra-avatars
S3_BUCKET_MEDIA=fluentra-media
S3_BUCKET_UPLOADS=fluentra-uploads
S3_BUCKET_DERIVED=fluentra-derived
S3_BUCKET_EXPORTS=fluentra-exports
S3_PRESIGN_PUT_TTL=5m
S3_PRESIGN_GET_TTL=15m
UPLOAD_MAX_MB=25

# ------------------------------------------------------------------ auth
JWT_SIGNING_KEY=change-me-at-least-32-bytes-long-secret                       # REQUIRED - secret
JWT_PREVIOUS_KEY=                                                             # set during key rotation only
JWT_ISSUER=fluentra
JWT_AUDIENCE=fluentra-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
PASSWORD_MIN_LENGTH=12
BREACHED_PASSWORD_CHECK=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW=15m
MFA_REQUIRED_FOR_ADMIN=true

# --------------------------------------------------- OTP challenges (ADR-0021)
OTP_CODE_LENGTH=6
OTP_TTL=10m
PASSWORD_RESET_TTL=30m            # a reset email can sit unread; a signup code cannot
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
OTP_ISSUE_PER_SUBJECT_PER_HOUR=3
OTP_ISSUE_PER_IP_PER_HOUR=20       # also the per-IP challenge cap at the HTTP boundary
OTP_HMAC_KEY=change-me-32-bytes-minimum-for-otp-hmac                          # REQUIRED - secret

# ----------------------------------------------- persistent sign-in (ADR-0022)
SESSION_IDLE_WINDOW=720h           # 30d — default idle window
SESSION_IDLE_WINDOW_TRUSTED=2160h  # 90d — device the learner chose to trust
SESSION_ABSOLUTE_TTL=4320h         # 180d — never extended by activity
SESSION_IDLE_WINDOW_ADMIN=12h      # admins get neither extension
SESSION_ABSOLUTE_TTL_ADMIN=168h    # 7d
TRUSTED_DEVICE_LIMIT=10

# -------------------------------------------------- Google OAuth (ADR-0023)
OAUTH_GOOGLE_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=                                                   # secret
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:5173/auth/google/callback
OAUTH_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OAUTH_GOOGLE_ISSUER=https://accounts.google.com
OAUTH_JWKS_CACHE_TTL=6h
OAUTH_STATE_TTL=10m
# Apple deferred until an iOS app exists (App Store requirement at that point)
OAUTH_APPLE_ENABLED=false
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=                                                    # secret

# ------------------------------------------------------------------ mail
MAIL_TRANSPORT=smtp                # smtp | resend   (resend uses HTTPS API, bypasses SMTP port blocks)
MAIL_FROM="Fluentra <no-reply@fluentra.dev>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=                                                                # secret
SMTP_TLS=false
SMTP_DEV_MODE=true
RESEND_API_KEY=                                                               # secret — required when MAIL_TRANSPORT=resend

# -------------------------------------------------------------------- ai
#
# The five keys below are the ones the application actually reads today. One
# adapter speaks to every OpenAI-compatible server, so choosing a model — free,
# paid or local — is these two lines and nothing else:
#
#   Ollama (local, open weights, free)
#     AI_PROVIDER=openai_compatible
#     AI_BASE_URL=http://localhost:11434/v1
#     AI_MODEL=llama3.1:8b          # AI_API_KEY stays empty
#
#   OpenRouter (has :free models)
#     AI_PROVIDER=openai_compatible
#     AI_BASE_URL=https://openrouter.ai/api/v1
#     AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
#     AI_API_KEY=sk-or-...
#
#   Groq (free tier)
#     AI_PROVIDER=openai_compatible
#     AI_BASE_URL=https://api.groq.com/openai/v1
#     AI_MODEL=llama-3.1-8b-instant
#     AI_API_KEY=gsk_...
#
# `mock` is the default so `make dev` works with no key and no internet. It
# accepts every word it is given, so a real deployment must not leave it set.
AI_PROVIDER=mock                   # mock | openai_compatible
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=                                                                   # secret
AI_TIMEOUT=120s                    # generous: a local model is slow, not broken

# Everything below describes internal/platform/ai's full specification —
# routing, budget, caching, a fallback chain — and is NOT read by any code yet.
# See that module's AGENT.md for what is built.
AI_ENABLED=true
AI_TASK_ROUTES=config/ai-routes.yaml     # task -> tier, timeout, cache, fallback chain
AI_DEFAULT_CHAIN=anthropic,openai
AI_DAILY_BUDGET_USD=50
AI_BUDGET_WARN_PERCENT=80
AI_REQUEST_TIMEOUT=30s
AI_STREAM_TIMEOUT=120s
AI_MAX_RETRIES=3
AI_BREAKER_FAILURE_RATIO=0.5
AI_CACHE_ENABLED=true
AI_SEMANTIC_CACHE_ENABLED=false
ANTHROPIC_API_KEY=                                                            # secret
OPENAI_API_KEY=                                                               # secret
GEMINI_API_KEY=                                                               # secret
OPENROUTER_API_KEY=                                                           # secret
OLLAMA_BASE_URL=http://localhost:11434    # dev/CI only — see DEPENDENCIES.md 1.12

# ---------------------------------------------------------------- speech
SPEECH_PROVIDER=mock               # mock | azure | openai   (see plan review Q2)
SPEECH_API_KEY=                                                               # secret
SPEECH_REGION=
AUDIO_MAX_SECONDS=180
ASR_MIN_CONFIDENCE=0.6

# ------------------------------------------------------------------ jobs
WORKER_QUEUES=default:10,ai:4,media:2,notify:10,batch:2
WORKER_SHUTDOWN_GRACE=30s
JOB_MAX_ATTEMPTS=5
JOB_TIMEOUT=5m
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_PUBLISHED_RETENTION_DAYS=30  # delete delivered payloads after this dispatch-trail window

# ------------------------------------------------------------ telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=fluentra-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0        # 0.1 in production; tail sampling happens in the Collector
LOG_LEVEL=debug                    # debug | info | warn | error
LOG_FORMAT=json

# ----------------------------------------------------------- rate limits
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_USER_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_UPLOAD_PER_HOUR=30

# -------------------------------------------------------------- payments
PAYMENT_PROVIDER=mock              # mock | vnpay | momo | stripe   (see plan review Q1)
PAYMENT_API_KEY=                                                              # secret
PAYMENT_WEBHOOK_SECRET=                                                       # secret
PAYMENT_RETURN_URL=http://localhost:5173/billing/return
SUBSCRIPTION_GRACE_DAYS=7

# ------------------------------------------------------------- features
FEATURE_FLAGS_CACHE_TTL=30s
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,vi
