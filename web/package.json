{
  "name": "fluentra-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../api/openapi/openapi.yaml -o src/types/api.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-zone": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-fetch": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.0",
    "i18next": "26.3.6",
    "lucide-react": "^0.300.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "17.0.11",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.24.2",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.51.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "^4.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "msw": "^2.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.66.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
