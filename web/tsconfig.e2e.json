{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // The layout specs stub API responses. Typing those stubs against the
    // generated schema is what stops them drifting from the spec the way the
    // first round of journeys did — a stub for an endpoint that does not exist
    // matches nothing and asserts against a screen the app never rendered.
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["playwright.config.ts", "e2e", "src/types/api.ts"]
}
